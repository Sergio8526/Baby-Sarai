# Copia este archivo como .env y completa los valores.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=baby_sarai

# Servidor
PORT=3000

# Seguridad (JWT). Usa un texto largo y aleatorio; puedes generarlo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRETO=
JWT_EXPIRA=2h

# Envío de los pedidos (pesos colombianos)
ENVIO_COSTO=10000
ENVIO_GRATIS_DESDE=150000
